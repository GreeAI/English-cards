   <string notr="true">/* Основной фон с полупрозрачностью */
QWidget {
    background: rgba(40, 50, 70, 150); /* Темно-синий с прозрачностью */
    border-radius: 15px;
}

/* Стиль для всех рамок (QFrame) с унифицированной обводкой */
QFrame {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2); /* Такая же обводка как у QLineEdit */
    border-radius: 12px;
    color: white;
}

/* Кнопки с единообразной обводкой */
QPushButton {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2); /* Теперь совпадает с QLineEdit */
    border-radius: 8px;
    color: white;
    padding: 10px;
    font-size: 14px;
}

QPushButton:hover {
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.3); /* Чуть ярче при наведении */
}

QPushButton:pressed {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

/* Стили для полей ввода (оставлены как эталон) */
QLineEdit, QTextEdit {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2); /* Эталонная обводка */
    border-radius: 8px;
    padding: 8px;
    color: white;
    selection-background-color: rgba(100, 150, 200, 0.5);
}

/* Дополнительно: стиль для выпадающих списков */
QComboBox {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    padding: 5px;
    color: white;
    selection-background-color: rgba(100, 150, 200, 0.5);
}

QComboBox QAbstractItemView {
    background: rgba(40, 50, 70, 200);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    selection-background-color: rgba(100, 150, 200, 0.5);
}</string>
